<?xml version="1.0" encoding="UTF-8"?>
<!--
  Used only by hosting/Dockerfile.render. Render's build servers could not download from
  repo.maven.apache.org, so the image build reads Maven Central through Google's public mirror.
  The artifacts are the same files; Maven still checks their checksums.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
