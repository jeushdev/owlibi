# Copy to .env; use three different locally generated passwords. Never commit .env.
OWLIBI_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
OWLIBI_MIGRATION_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
OWLIBI_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
OWLIBI_DB_PORT=55580
OWLIBI_API_PORT=8080
# Tools use the terminal's PATH/JAVA_HOME. Do not save installation paths here.
